{
  "name": "briar-expo",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "npm@10.9.11",
  "scripts": {
    "start": "expo start --dev-client",
    "android:prepare": "CI=1 expo prebuild --platform android --clean --no-install --template expo-template-bare-minimum@54.0.54",
    "android:apk": "npm run android:prepare && cd android && ./gradlew :app:assembleDebug",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:device": "bash scripts/smoke-android.sh",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "expo": "54.0.38",
    "expo-dev-client": "6.0.21",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "expo-modules-core": "3.0.30"
  },
  "devDependencies": {
    "@types/react": "19.1.17",
    "eslint": "9.39.4",
    "eslint-config-expo": "10.0.0",
    "typescript": "5.9.3"
  }
}
